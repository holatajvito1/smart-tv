<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere, except radiojar.com: Primera 88.1's https stream URL always redirects to a
     short-lived plain-http address on n0x.radiojar.com, which Android would otherwise block. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">radiojar.com</domain>
    </domain-config>
</network-security-config>
